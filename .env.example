# =============================================================================
# AIOps for DPI Infrastructure — environment configuration
# Copy this file to `.env` and adjust. `.env` is git-ignored.
#   PowerShell:  Copy-Item .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------
# Free-form name of the environment: local | dev | staging | prod
AIOPS_ENV=local
# DEBUG | INFO | WARNING | ERROR
AIOPS_LOG_LEVEL=INFO
# json (machine readable, use in Docker) | console (colourful, use in a terminal)
AIOPS_LOG_FORMAT=json
# Which DPI platform this deployment targets: mojaloop | mosip | beckn
AIOPS_DPI_PLATFORM=mojaloop

# -----------------------------------------------------------------------------
# HOSTNAMES: why these are localhost
# -----------------------------------------------------------------------------
# This file is read by code running on YOUR MACHINE (tests, scripts, a service you
# start by hand), which reaches the containers through their published ports on
# localhost. Services that run INSIDE docker compose get these same variables
# overridden to the compose service names (timescaledb, redis, prometheus, ...)
# in the compose file itself, because container-to-container traffic uses Docker DNS.
#
# So: leave these as localhost. Do not "fix" them to the service names.

# -----------------------------------------------------------------------------
# TimescaleDB (PostgreSQL) — metric history + feature store + incident records
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aiops
POSTGRES_USER=aiops
# CHANGE ME before any non-local deployment.
POSTGRES_PASSWORD=aiops_local_dev_password
# Host port mapping (change if 5432 is already taken on your machine)
POSTGRES_HOST_PORT=5432

# -----------------------------------------------------------------------------
# Redis — event bus (Redis Streams) + short-lived state / circuit-breaker flags
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_HOST_PORT=6379

# -----------------------------------------------------------------------------
# Observability plane (module 2)
# -----------------------------------------------------------------------------
PROMETHEUS_URL=http://localhost:9090
PROMETHEUS_HOST_PORT=9090

LOKI_URL=http://localhost:3100
LOKI_HOST_PORT=3100

TEMPO_URL=http://localhost:3200
TEMPO_HOST_PORT=3200
# Tempo's OTLP receivers, published so a service you start by hand traces to the same
# place the containers do.
TEMPO_OTLP_GRPC_PORT=4317
TEMPO_OTLP_HTTP_PORT=4318
# Where services push traces. Containers get this overridden to http://tempo:4318 in
# docker-compose.observability.yml - inside the network, localhost is the container itself.
OTLP_ENDPOINT=http://localhost:4318

# Tracing. On by default: emitting a span does not change the system being observed, and a
# trace that was never recorded cannot be recovered after the incident.
TRACING_ENABLED=true
# 1.0 keeps every trace. At the simulator's handful of requests per second, sampling only
# makes traces intermittently missing, which is harder to debug than the extra volume.
TRACE_SAMPLE_RATIO=1.0

ALERTMANAGER_URL=http://localhost:9093
ALERTMANAGER_HOST_PORT=9093

# How often the metrics agent (module 3) collects. Matches prometheus.yml's scrape_interval:
# collecting faster would write the same values under new timestamps, inventing resolution
# the data does not have.
SCRAPE_INTERVAL_SECONDS=15

# Anomaly detector (module 4) host port.
ANOMALY_DETECTOR_PORT=8021

# -----------------------------------------------------------------------------
# Traffic prediction (module 5)
# -----------------------------------------------------------------------------
# Days of hourly history the forecaster trains on. 28 gives four weekly cycles, the minimum that
# lets a full week be held back for validation while three remain for fitting. Fewer than 14 cannot
# validate weekly seasonality at all.
FORECAST_HISTORY_DAYS=28
# How often to re-forecast. Minutes, not seconds: the input is an hourly rollup, so forecasting
# faster would produce near-identical predictions and fill the table with noise.
FORECAST_INTERVAL_SECONDS=600
# Floor on the capacity headroom a scaling recommendation carries. The actual headroom is the larger
# of this and the measured backtest MAPE, so forecast accuracy drives the safety margin.
SCALING_MIN_HEADROOM=0.25

# Grafana Alloy ships container logs to Loki. Replaces Promtail, which reached end of life
# on 2 March 2026. This port serves Alloy's own UI and /metrics.
ALLOY_HOST_PORT=12345

GRAFANA_HOST_PORT=3000
GRAFANA_ADMIN_USER=admin
# CHANGE ME before any non-local deployment.
GRAFANA_ADMIN_PASSWORD=admin

# -----------------------------------------------------------------------------
# AIOps service ports (host side)
# -----------------------------------------------------------------------------
API_GATEWAY_PORT=8000
METRICS_AGENT_PORT=8020
ANOMALY_DETECTOR_PORT=8021
TRAFFIC_PREDICTOR_PORT=8022
RCA_ENGINE_PORT=8023
HEALING_ENGINE_PORT=8024
CHAOS_AGENT_PORT=8025
DASHBOARD_PORT=5173

# -----------------------------------------------------------------------------
# Mojaloop simulator (module 2) — stand-in for real Mojaloop microservices
# -----------------------------------------------------------------------------
MOJALOOP_SIM_PORT=8010
# Host ports for the five simulated services. Container port is always 8000; these are
# only for poking a service directly (its /sim endpoint, /metrics, or /docs).
SIM_ML_API_ADAPTER_PORT=8011
SIM_CENTRAL_LEDGER_PORT=8012
SIM_QUOTING_SERVICE_PORT=8013
SIM_ACCOUNT_LOOKUP_PORT=8014
SIM_TRANSACTION_REQUEST_PORT=8015
# Baseline transactions per second the simulator generates
MOJALOOP_SIM_BASE_TPS=25
# Adds a daily sine-wave shape to traffic so forecasting has something to learn
MOJALOOP_SIM_SEASONALITY=true

# -----------------------------------------------------------------------------
# ML / model behaviour
# -----------------------------------------------------------------------------
# Where trained model artifacts are written/read
MODEL_ARTIFACT_DIR=/app/ml/artifacts
# Expected fraction of anomalous points — Isolation Forest `contamination`
ANOMALY_CONTAMINATION=0.02
# Minimum rows of history required before a model will train
ANOMALY_MIN_TRAINING_ROWS=2000
# Forecast horizons in hours, comma separated
FORECAST_HORIZONS=1,6,24
# Re-train cadence in minutes
MODEL_RETRAIN_INTERVAL_MINUTES=60

# -----------------------------------------------------------------------------
# Self-healing safety rails (module 6)
# -----------------------------------------------------------------------------
# false = compute and log the action but never execute it. Start here.
HEALING_ENABLED=false
# Never run more than this many remediations per hour, across all playbooks
HEALING_MAX_ACTIONS_PER_HOUR=10
# Seconds to wait before the same playbook may fire again for the same target
HEALING_COOLDOWN_SECONDS=300
# Docker socket used to restart/scale simulated services locally
DOCKER_SOCKET=/var/run/docker.sock

# -----------------------------------------------------------------------------
# Dashboard (module 8)
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws
