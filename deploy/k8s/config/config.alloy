// Grafana Alloy - log collection on the kind cluster (module 10).
//
// The Compose config (infra/alloy/config.alloy) tails containers through the Docker
// socket. Here Alloy discovers pods through the Kubernetes API and tails their logs through
// the same API (loki.source.kubernetes), so it needs no hostPath mounts and no privileges
// beyond `get/list/watch` on pods and pods/log in the `aiops` namespace.
//
// The labels it produces - service, service_group, platform, env - and the JSON stage that
// lifts trace_id into structured metadata are the same as Compose, so the Grafana log
// panels and the log -> trace links work unchanged.

discovery.kubernetes "pods" {
	role = "pod"
	namespaces {
		names = ["aiops"]
	}
}

discovery.relabel "pods" {
	targets = discovery.kubernetes.pods.targets

	rule {
		source_labels = ["__meta_kubernetes_pod_name"]
		target_label  = "pod"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_container_name"]
		target_label  = "container"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_label_app_kubernetes_io_name"]
		target_label  = "service"
	}

	// DPI workload and AIOps services emit structured JSON; everything else is infra.
	rule {
		source_labels = ["__meta_kubernetes_pod_label_app_kubernetes_io_part_of"]
		regex         = "mojaloop|aiops"
		target_label  = "service_group"
		replacement   = "dpi"
	}

	rule {
		source_labels = ["service_group"]
		regex         = ""
		target_label  = "service_group"
		replacement   = "infra"
	}
}

loki.source.kubernetes "pods" {
	targets    = discovery.relabel.pods.output
	forward_to = [loki.process.dpi.receiver]
}

loki.process "dpi" {
	stage.static_labels {
		values = {
			platform = "mojaloop",
			env      = "kind",
		}
	}

	stage.match {
		selector = "{service_group=\"dpi\"}"

		stage.json {
			expressions = {
				svc      = "service",
				level    = "level",
				logger   = "logger",
				event    = "event",
				ts       = "timestamp",
				trace_id = "trace_id",
				span_id  = "span_id",
			}
		}

		stage.labels {
			values = {
				service = "svc",
				level   = "level",
			}
		}

		stage.timestamp {
			source = "ts"
			format = "RFC3339Nano"
		}

		stage.structured_metadata {
			values = {
				logger   = "logger",
				event    = "event",
				trace_id = "trace_id",
				span_id  = "span_id",
			}
		}
	}

	stage.drop {
		older_than          = "1h"
		drop_counter_reason = "backlog_older_than_1h"
	}

	forward_to = [loki.write.loki.receiver]
}

loki.write "loki" {
	endpoint {
		url = "http://loki:3100/loki/api/v1/push"
	}
}

logging {
	level  = "warn"
	format = "logfmt"
}
