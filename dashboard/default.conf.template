# Serves the built dashboard and proxies the gateway on the same origin.
#
# This is an nginx *template*: the official image runs envsubst over it at start-up, but
# only for variables that are set in the environment, so nginx's own $host etc. survive.
#   DASHBOARD_AUTH  "off" (default) or a realm name. On a public VM scripts/k8s.sh sets
#                   it and mounts an htpasswd file, so only you can trigger chaos runs.

# Resolve the gateway at request time (a variable in proxy_pass forces this). Without it
# nginx resolves once at start-up and refuses to start at all if the gateway's Service
# does not exist yet.
resolver kube-dns.kube-system.svc.cluster.local valid=10s ipv6=off;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    set $gateway http://api-gateway.aiops.svc.cluster.local:8000;

    auth_basic "${DASHBOARD_AUTH}";
    auth_basic_user_file /etc/nginx/auth/htpasswd;

    location /api/ {
        proxy_pass $gateway;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    location /ws {
        proxy_pass $gateway;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        # Live event stream: keep idle sockets open well past nginx's 60s default.
        proxy_read_timeout 1h;
    }

    location = /health {
        proxy_pass $gateway;
    }

    # Hashed assets never change under the same name; the HTML shell always revalidates.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Client-side routing: unknown paths get the app shell.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}
